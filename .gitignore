# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.pyc
*.pyo

# Git worktrees
.worktrees/

# Spatial eval — DB files
# eval.duckdb is committed so Streamlit Community Cloud can read pre-computed results
# Ignore backup/temp DB files only
src/exercises/33-spatial-eval/data/*.duckdb.bak
src/exercises/33-spatial-eval/data/*.db.bak

# Eval framework runtime caches
src/exercises/33-spatial-eval/data/reference/cache_osm/
src/exercises/33-spatial-eval/data/reference/cache_wikidata/

# Generated data files (run ETL to regenerate)
public/data/*.parquet
src/exercises/**/output/*.parquet

# EO Extraction — generated outputs (re-run exercises to regenerate)
src/exercises/eo-extraction/output/

# Felt Integration — generated outputs
src/exercises/felt-integration/output/

# Exercise binary data and generated outputs — re-run exercises to regenerate.
# Committed data belongs in public/ (served via CDN) not src/exercises/.
src/exercises/**/*.zarr
src/exercises/**/weather_data.zarr/
src/exercises/**/*.png
src/exercises/**/*.jpg
src/exercises/**/*.jpeg
src/exercises/**/*.tif
src/exercises/**/*.tiff
src/exercises/**/*.nc

# Spatial eval runtime data (re-generated by running the eval)
# We commit the JSON caches and results.db so that the Streamlit Community Cloud deployment
# has the full evaluation data to render the UI.
src/exercises/33-spatial-eval/data/* copy*/
# results.db is committed so Streamlit Community Cloud can read pre-computed results

# Raw downloads in data/ root (canonical copies live in data/reference/)
src/exercises/33-spatial-eval/data/*.geojson

# GeoPandas — large data files (download separately, see data/README.md)
src/exercises/34-geopandas/data/es_cn.parquet
src/exercises/34-geopandas/data/internet-speeds.parquet

# Module 23 Ibis — generated geoparquet output
src/exercises/23-scout-etl/power-infra-usa.geoparquet

# Temp staging area — remove once migration to modules is complete
src/temp_copied_from_other_repos/
.env*.local

# Generated by scripts/copy-maplibre-worker.mjs (predev/prebuild)
public/maplibre/
